{
    "name": "hryvinskyi/magento2-banner-slider-frontend-ui",
    "description": "Banner Slider frontend module: slider widget and block, responsive pictures, video embeds and slider scripts",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "~8.3.0||~8.4.0",
        "hryvinskyi/magento2-banner-slider": "^2.0",
        "hryvinskyi/magento2-banner-slider-api": "^2.0",
        "hryvinskyi/magento2-head-tag-manager": "^2.3",
        "hryvinskyi/magento2-splide-js": "^1.0",
        "magento/framework": "^103.0.7",
        "magento/module-cms": "^104.0",
        "magento/module-csp": "^100.4",
        "magento/module-customer": "^103.0",
        "magento/module-store": "^101.1",
        "magento/module-widget": "^101.2",
        "psr/clock": "^1.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\BannerSliderFrontendUi\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hryvinskyi\\BannerSliderFrontendUi\\Test\\": "Test/"
        }
    },
    "archive": {
        "exclude": [
            "/Test"
        ]
    }
}
