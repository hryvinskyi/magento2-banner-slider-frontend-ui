declare(strict_types=1);

use Hryvinskyi\BannerSliderFrontendUi\Block\Widget\Slider;
use Magento\Framework\Escaper;

/**
 * @var Slider $block
 * @var Escaper $escaper
 */

$view = $block->getSliderView();
if ($view === null) {
    return;
}
?>
<div<?= /* @noEscape */ $view->getContainerAttributes()->render($escaper) ?>>
    <?php if ($view->hasPauseControl()): ?>
        <button type="button" class="hbs-slider__toggle" data-hbs-toggle hidden>
            <?= $escaper->escapeHtml($view->getPauseLabel()) ?>
        </button>
    <?php endif; ?>
    <div class="splide">
        <div class="splide__track">
            <ul class="splide__list">
                <?php foreach ($view->getSlides() as $slide): ?>
                    <li<?= /* @noEscape */ $slide->getAttributes()->render($escaper) ?>>
                        <?= /* @noEscape */ $slide->getContentHtml() ?>
                    </li>
                <?php endforeach; ?>
            </ul>
        </div>
    </div>
</div>
