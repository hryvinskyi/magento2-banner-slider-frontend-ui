declare(strict_types=1);

use Hryvinskyi\BannerSliderFrontendUi\Model\View\VideoSlideView;
use Magento\Framework\Escaper;

/**
 * A video slide embedded in an iframe.
 *
 * A regular video shows a click-to-load facade; the iframe waits inside the `<template>`, so nothing is requested
 * from the video provider until the visitor presses the button. A background video renders its iframe directly.
 *
 * @var VideoSlideView $view
 * @var Escaper $escaper
 */

$facadeImage = $view->getFacadeImage();
$loadingHtml = $view->isLazy() ? ' loading="lazy"' : '';
?>
<div<?= /* @noEscape */ $view->getWrapper()->render($escaper) ?>>
    <?php if ($view->hasFacade()): ?>
        <button type="button" class="hbs-slide__facade" data-hbs-facade>
            <?php if ($facadeImage !== null): ?>
                <img<?= /* @noEscape */ $facadeImage->render($escaper) ?>>
            <?php endif; ?>
            <span class="hbs-slide__facade-label"><?= $escaper->escapeHtml($view->getFacadeLabel()) ?></span>
        </button>
        <template data-hbs-player>
            <iframe<?= /* @noEscape */ $view->getPlayer()->render($escaper) ?>></iframe>
        </template>
    <?php else: ?>
        <iframe<?= /* @noEscape */ $view->getPlayer()->render($escaper) . $loadingHtml ?>></iframe>
    <?php endif; ?>
</div>
<?php if ($view->getOverlayHtml() !== ''): ?>
    <div class="hbs-slide__overlay"><?= /* @noEscape */ $view->getOverlayHtml() ?></div>
<?php endif; ?>
